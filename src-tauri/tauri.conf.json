{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "shs-app",
	"version": "0.1.0",
	"identifier": "com.shs-app.dev",
	"build": {
		"frontendDist": "../.output/public/",
		"devUrl": "http://localhost:3000",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm generate"
	},
	"app": {
		"windows": [
			{
				"title": "shs-app",
				"width": 800,
				"height": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["shs"]
			},
			"mobile": [
				{
					"scheme": ["shs"],
					"appLink": false
				}
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
